#!/usr/bin/env bash
set -euo pipefail

ORIG_CD="$(pwd)"
HERD_HOME="$USERPROFILE/.config/herd/bin"
TARGET_PHP=""

[[ -f "$HERD_HOME/herd.phar" ]] || exit 1

if [[ -f "$ORIG_CD/.phpversion" ]]; then
  PHP_VER="$(tr -d '[:space:]' < "$ORIG_CD/.phpversion")"
  PHP_VER="${PHP_VER/./}"          # 8.1 → 81
  TARGET_PHP="$HERD_HOME/php${PHP_VER}/php.exe"
else
  # Find the most recent php.exe under Herd to run which-php (avoids recursion via PATH)
  BOOTSTRAP_PHP=""
  for d in "$HERD_HOME"/php*/php.exe; do
    [[ -f "$d" ]] && BOOTSTRAP_PHP="$d"
  done
  [[ -z "$BOOTSTRAP_PHP" ]] && exit 1
  TARGET_PHP="$("$BOOTSTRAP_PHP" "$HERD_HOME/herd.phar" which-php "$ORIG_CD" 2>/dev/null | tr -d '\r')"
fi

[[ -z "$TARGET_PHP" ]] && exit 1
[[ -f "$TARGET_PHP" ]] || exit 1

"$TARGET_PHP" "$HERD_HOME/composer.phar" "$@"
